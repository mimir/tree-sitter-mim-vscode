{
  "name": "tree-sitter-mim-vscode",
  "displayName": "tree-sitter-mim-vscode",
  "description": "Mim language support for VSCode using tree-sitter",
  "author": {
    "name": "fodinabor",
    "url": "https://github.com/fodinabor"
  },
  "publisher": "fodinabor",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/fodinabor/tree-sitter-mim-vscode"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "tree-sitter-mim-vscode config",
        "properties": {
          "tree-sitter-mim-vscode.languageConfigs": {
            "description": "A list of objects with the keys \"lang\", \"parser\", and \"highlights\". Optionally \"injections\", \"injectionOnly\", and \"semanticTokenTypeMappings\" can be added.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "lang",
                "parser",
                "highlights"
              ],
              "properties": {
                "lang": {
                  "type": "string",
                  "description": "The name of the language"
                },
                "parser": {
                  "type": "string",
                  "description": "The path to the parser `.wasm` file"
                },
                "highlights": {
                  "type": "string",
                  "description": "The path to the highlights `.scm` file"
                },
                "injections": {
                  "type": [
                    "string",
                    null
                  ],
                  "description": "The path to the injections `.scm` file"
                },
                "injectionOnly": {
                  "type": "boolean",
                  "default": false,
                  "description": "Use language only for injections, not for top-level syntax highlighting"
                },
                "semanticTokenTypeMappings": {
                  "type": "object",
                  "description": "Mappings from highlighting query names to VSCode token types and modifiers",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "targetTokenModifiers": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "targetTokenType": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "targetTokenType"
                    ]
                  }
                }
              }
            },
            "default": []
          },
          "tree-sitter-mim-vscode.debug": {
            "type": "boolean",
            "default": false,
            "description": "Enable debug logging"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "tree-sitter-mim-vscode.reload",
        "title": "tree-sitter-mim-vscode: Reload"
      }
    ],
		"languages": [
			{
				"id": "mim",
				"extensions": [
					".mim"
				],
				"configuration": "./mim-language-configuration.json"
			}
		]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "./generate_wasm.sh && webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "copy-webpack-plugin": "^13.0.0"
  },
  "dependencies": {
    "@vscode/vsce": "^3.4.2",
    "web-tree-sitter": "^0.25.4"
  }
}
